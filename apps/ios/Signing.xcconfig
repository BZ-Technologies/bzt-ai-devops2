// Default signing values for shared/repo builds.
// Auto-selected local team overrides live in .local-signing.xcconfig (git-ignored).
// Manual local overrides can go in LocalSigning.xcconfig (git-ignored).

#include "Config/Version.xcconfig"

OPENBZ_CODE_SIGN_STYLE = Manual
OPENBZ_DEVELOPMENT_TEAM = Y5PE65HELJ

OPENBZ_APP_BUNDLE_ID = ai.openbz.client
OPENBZ_SHARE_BUNDLE_ID = ai.openbz.client.share
OPENBZ_WATCH_APP_BUNDLE_ID = ai.openbz.client.watchkitapp
OPENBZ_WATCH_EXTENSION_BUNDLE_ID = ai.openbz.client.watchkitapp.extension
OPENBZ_ACTIVITY_WIDGET_BUNDLE_ID = ai.openbz.client.activitywidget

OPENBZ_APP_PROFILE = ai.openbz.client Development
OPENBZ_SHARE_PROFILE = ai.openbz.client.share Development

// Keep local includes after defaults: xcconfig is evaluated top-to-bottom,
// so later assignments in local files override the defaults above.
#include? ".local-signing.xcconfig"
#include? "LocalSigning.xcconfig"
